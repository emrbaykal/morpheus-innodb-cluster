// Generated by Ansible. Safe to re-run: existing cluster and members are kept.
var nodes = {{ groups['mysql_nodes'] | to_json }};
var primary = {{ inventory_hostname | to_json }};
var user = {{ innodb_admin_user | to_json }};
var password = {{ innodb_admin_password | to_json }};

function target(host) {
    return {host: host, port: 3306, user: user, password: password};
}

for (var i = 0; i < nodes.length; i++) {
    print("Configuring " + nodes[i] + "\n");
    dba.configureInstance(target(nodes[i]), {restart: true});
}

shell.connect(target(primary));
var cluster;
try {
    cluster = dba.getCluster();
    print("Cluster already exists\n");
} catch (e) {
    cluster = dba.createCluster({{ innodb_cluster_name | to_json }});
    print("Cluster created\n");
}

for (var i = 0; i < nodes.length; i++) {
    if (nodes[i] === primary) continue;
    try {
        cluster.addInstance(target(nodes[i]), {recoveryMethod: "clone"});
        print(nodes[i] + " added\n");
    } catch (e) {
        if (String(e).indexOf("already") < 0) throw e;
        print(nodes[i] + " is already a member\n");
    }
}

var routerPassword = {{ router_password | to_json }};
try {
    cluster.setupRouterAccount("routeruser", {password: routerPassword});
} catch (e) {
    if (String(e).indexOf("already exists") < 0) throw e;
    cluster.setupRouterAccount("routeruser", {password: routerPassword, update: true});
}
print(JSON.stringify(cluster.status(), null, 2) + "\n");
